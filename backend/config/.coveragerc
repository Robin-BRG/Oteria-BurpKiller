[run]
source = ..
omit =
    */venv/*
    */tests/*
    */scripts/*
    */config/*
    */utils/*
    test_*.py
    conftest.py
    setup.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod

[html]
directory = ../htmlcov
